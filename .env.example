# Shopify CLI normally supplies these during local dev.
# Do not put real secrets in GitHub.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=
SCOPES=read_products,write_products

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_TEXT_MODEL=gpt-5.1-mini
# Future/premium idea, not active by default:
# OPENAI_TEXT_MODEL_PREMIUM=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# Keep image testing controlled.
MAX_IMAGES_PER_OPTIMIZE=1
MAX_IMAGE_BYTES=25000000
DOWNLOAD_TIMEOUT_MS=15000

# Allowed image/spec hosts.
IMAGE_ALLOWED_HOSTS=cdn.shopify.com,cdn.shopifycdn.net,cdn.shopifycloud.com
SPEC_ALLOWED_HOSTS=rezar.com,cdn.shopify.com
